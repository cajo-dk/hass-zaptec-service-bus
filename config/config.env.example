AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://example.servicebus.windows.net/;SharedAccessKeyName=example;SharedAccessKey=replace-me
AZURE_SERVICE_BUS_TOPIC_NAME=replace-me
AZURE_SERVICE_BUS_SUBSCRIPTION_NAME=replace-me
AZURE_SERVICE_BUS_MAX_WAIT_TIME=5
AZURE_SERVICE_BUS_RECEIVE_MODE=peek_lock
AZURE_SERVICE_BUS_TRANSPORT=amqp

MQTT_HOST=mqtt.example.net
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_CLIENT_ID=zaptec-charge-monitor
MQTT_BASE_TOPIC=zaptec
MQTT_RETAIN=true

# Leave disabled for a broker/application that is not Home Assistant.
MQTT_DISCOVERY_ENABLED=false
MQTT_DISCOVERY_PREFIX=homeassistant
LOG_LEVEL=INFO

# Optional Monta charging-plan sensors. Export a Hub session Cookie header once.
MONTA_ENABLED=false
MONTA_CLIENT_ID=
MONTA_CLIENT_SECRET=
MONTA_HUB_COOKIE=
MONTA_CHARGE_POINT_ID=0
MONTA_OPERATOR_ID=1
MONTA_POLL_INTERVAL=30
MONTA_BATTERY_CAPACITY_KWH=61.0
MONTA_CHARGING_POWER_KW=10.4
